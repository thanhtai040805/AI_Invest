# Production Compose configuration. Copy to .env on the server, then fill required values.
# Never commit a populated env file.
# CORS_ORIGIN must be the real public HTTPS origin before deployment.
DB_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_USER=aiinvest_prod_admin
RABBITMQ_PASS=
NODE_ENV=production
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
CORS_ORIGIN=
AI_ENGINE_ADMIN_TOKEN=
INTERNAL_SERVICE_TOKEN=
# Multi-agent LLM: Xkiro primary, EvoMap fallback. EvoMap is also used by OCR/triage.
XKIRO_API_KEY=
EVOMAP_API_KEY=
MULTI_AGENT_ACCOUNT_ID=
PORTFOLIO_AUTOMATION_ENABLED=false
MULTI_AGENT_MODE=SHADOW_RUNNER
STANDALONE_ML_ACCOUNT_ID=standalone-pure-ml-fund-account
STANDALONE_ML_MODE=SHADOW_RUNNER
STANDALONE_ML_POSITION_WEIGHT=0.20
DNSE_ENABLED=false
DNSE_API_KEY=
DNSE_API_SECRET=
DNSE_ACCOUNT_NO=
DNSE_BASE_URL=https://openapi.dnse.com.vn
DNSE_REDIS_CHANNEL_PREFIX=dnse:event
R2_ACCOUNT_ID=
R2_ENDPOINT_URL=
R2_BUCKET_NAME=aiinvest-bctc-prod
R2_TEST_BUCKET_NAME=aiinvest-bctc-test
R2_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_SOCKET_URL=/
NEXT_PUBLIC_WS_URL=/

XKIRO_API_KEY=
