# Production Compose configuration. Copy to .env on the server, then fill required values.
# Never commit a populated env file.
# CORS_ORIGIN must be the real public HTTPS origin before deployment.
DB_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_USER=aiinvest_prod_admin
RABBITMQ_PASS=
NODE_ENV=production
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
CORS_ORIGIN=
AI_ENGINE_ADMIN_TOKEN=
INTERNAL_SERVICE_TOKEN=
# Production multi-agent LLM uses DeepInfra; EvoMap remains available for OCR/triage.
XKIRO_API_KEY=
EVOMAP_API_KEY=
DEEPINFRA_API_KEY=
LLM_BASE_URL=https://api.deepinfra.com/v1/openai
MULTI_AGENT_ACCOUNT_ID=
PORTFOLIO_AUTOMATION_ENABLED=false
MULTI_AGENT_MODE=SHADOW_RUNNER
DNSE_ENABLED=false
DNSE_API_KEY=
DNSE_API_SECRET=
DNSE_ACCOUNT_NO=
DNSE_BASE_URL=https://openapi.dnse.com.vn
DNSE_REDIS_CHANNEL_PREFIX=dnse:event
R2_ACCOUNT_ID=
R2_ENDPOINT_URL=
R2_BUCKET_NAME=aiinvest-bctc-prod
R2_TEST_BUCKET_NAME=aiinvest-bctc-test
R2_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_SOCKET_URL=/
NEXT_PUBLIC_WS_URL=/

# ── Optional SAG Research Profile (`docker compose --profile research up -d`) ──
# Ignored completely by standard PROD `docker compose up -d` (0 impact on ai-engine / trading).
SAG_ENVIRONMENT=prod
SAG_SECRET_KEY=
SAG_BFF_SERVICE_TOKEN=
SAG_DB_PASSWORD=
SAG_MINERU_OFFICIAL_MODEL=vlm
SAG_MINERU_POLL_TIMEOUT=900
SAG_MINERU_OFFICIAL_API_TOKEN_0=
SAG_MINERU_OFFICIAL_API_TOKEN_1=
# DeepInfra Reranker reuses DEEPINFRA_API_KEY automatically; SiliconFlow Kev-4b stays disabled until key is provided.
SAG_RERANK_PROVIDER=deepinfra
SAG_RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
SAG_DECISION_PROVIDER=disabled
SAG_DECISION_MODEL=Kev-4b
SAG_SILICONFLOW_API_KEY=
SAG_USER_MEMORY_MODE=on
