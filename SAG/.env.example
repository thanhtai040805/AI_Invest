# Standalone SAG Knowledge Routing RAG environment configuration for AIInvest.
# Copy to .env and customize for local or server deployment.

# ── Network & Runtime ────────────────────────────────────
API_PORT=8000
QDRANT_PORT=6333
BIND_ADDRESS=127.0.0.1

SAG_ENVIRONMENT=dev
SAG_CORS_ORIGINS=http://localhost:3000
SAG_AUTH_MODE=local
SAG_ALLOW_REGISTRATION=false
SAG_SAG_LANGUAGE=en
# Production requires a strong random secret (>=32 bytes, e.g. openssl rand -hex 32).
SAG_SECRET_KEY=

# ── Storage Backends (PostgreSQL 16 + Qdrant) ────────────
POSTGRES_USER=sag
POSTGRES_PASSWORD=sag
POSTGRES_DB=sag
SAG_SAG_VECTOR_PROVIDER=qdrant
SAG_SAG_RELATIONAL_PROVIDER=postgres
# Leave SAG_SAG_QDRANT_URL empty to use the local qdrant service (http://qdrant:6333).
SAG_SAG_QDRANT_URL=
SAG_SAG_QDRANT_API_KEY=
QDRANT_API_KEY=

# ── LLM & Embedding (Zero-LLM Ingest by Default) ─────────
# Benchmark baseline: Qwen/Qwen3-Embedding-0.6B (1024 dims) + Qwen/Qwen3-8B.
SAG_LLM_PROVIDER=openai
SAG_LLM_BASE_URL=https://api.siliconflow.com/v1
SAG_LLM_API_KEY=
SAG_LLM_MODEL=Qwen/Qwen3-8B
SAG_LLM_MAX_TOKENS=20000
SAG_LLM_STRUCTURED_OUTPUT_MODE=auto
SAG_LOCK_LLM_CONFIG=false

SAG_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
SAG_EMBEDDING_BASE_URL=https://api.siliconflow.com/v1
SAG_EMBEDDING_API_KEY=
SAG_EMBEDDING_DIMENSIONS=1024
SAG_EMBEDDING_CONCURRENCY=6
SAG_EMBEDDING_TIMEOUT=60
SAG_EMBEDDING_MAX_RETRIES=3

# ── Optional Query Decision Router ───────────────────────
SAG_DECISION_PROVIDER=disabled
SAG_DECISION_MODEL=Kev-4b
SAG_SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1
SAG_SILICONFLOW_API_KEY=

# ── Document Parsing (Smart Hybrid MinerU + Isolated Local Worker) ──
SAG_DOCUMENT_PARSER=auto
SAG_MINERU_PROVIDER=official
SAG_MINERU_BASE_URL=https://mineru.net
SAG_MINERU_OFFICIAL_MODEL=vlm
SAG_MINERU_PARSE_METHOD=auto
SAG_MINERU_OFFICIAL_API_TOKEN=

SAG_OBJECT_INGEST_ALLOWED_HOSTS=.r2.cloudflarestorage.com
SAG_OBJECT_INGEST_ALLOW_PRIVATE_HOSTS_IN_DEV=false
SAG_OBJECT_INGEST_TIMEOUT_SECONDS=120
SAG_LOCAL_PARSE_WORKERS=2
SAG_LOCAL_PARSE_TIMEOUT_SECONDS=90
SAG_LOCAL_PARSE_MAX_TASKS_PER_CHILD=25
SAG_MINERU_IO_CONCURRENCY=16
SAG_FAST_PARSE_CONCURRENCY=16
SAG_PER_PROJECT_HEAVY_PARSE_LIMIT=3
SAG_REMOTE_SNAPSHOT_GC_ENABLED=true

# ── Knowledge Routing RAG Pipeline (FOUNDATION Only, No E2 LLM) ────
# Canonical ingestion skips per-chunk Event/Entity LLM extraction (0 ingest LLM calls).
SAG_DOCUMENT_EVENT_EXTRACTION_ENABLED=false
SAG_KNOWLEDGE_WORKER_ENABLED=true
SAG_KNOWLEDGE_CONCURRENCY=4
SAG_KNOWLEDGE_QUEUE_CAPACITY=256
SAG_KNOWLEDGE_GRAPH_TIMEOUT_SECONDS=300
SAG_SESSION_CONTEXT_MODE=off
