# Standalone SAG Knowledge Routing RAG environment configuration for AIInvest.
# Copy to .env and customize for local or server deployment.

# ── Network & Runtime ────────────────────────────────────
API_PORT=18000
QDRANT_PORT=16333
SAG_PG_PORT=55432
BIND_ADDRESS=127.0.0.1

SAG_ENVIRONMENT=dev
SAG_CORS_ORIGINS=http://localhost:3000
# continuum + SAG_BFF_SERVICE_TOKEN enables standalone project-scoped ingest & search
# via /api/v1/projects/{ticker}/documents/* and /api/v1/auth/continuum-login (no external JWKS required).
SAG_AUTH_MODE=continuum
SAG_BFF_SERVICE_TOKEN=aiinvest-sag-bff-dev-token-change-me-32bytes
SAG_ALLOW_REGISTRATION=false
SAG_SAG_LANGUAGE=vi
# Dev placeholder only; prod startup rejects empty, <32-byte, or known default secrets.
SAG_SECRET_KEY=dev-insecure-secret-change-me-in-production-0123456789

# ── Storage Backends (PostgreSQL 16 + Qdrant — Isolated from Thesis 'sag') ──
POSTGRES_USER=aiinvest_sag
POSTGRES_PASSWORD=aiinvest_sag
POSTGRES_DB=aiinvest_sag
SAG_SAG_VECTOR_PROVIDER=qdrant
SAG_SAG_RELATIONAL_PROVIDER=postgres
# Leave unset to use http://qdrant:6333 in Docker Compose or http://localhost:16333 locally.
# Set to a Qdrant Cloud URL + API key for managed Qdrant.
# SAG_SAG_QDRANT_URL=http://localhost:16333
# SAG_SAG_QDRANT_API_KEY=
# QDRANT_API_KEY=
SAG_SAG_QDRANT_SHARED_COLLECTION=aiinvest_search_units
SAG_SAG_QDRANT_ON_DISK=true
SAG_SAG_QDRANT_SCALAR_QUANTIZATION=true

# ── LLM & Embedding (Zero-LLM Ingest by Default — DeepInfra OpenAI-compatible) ──
# Shared DeepInfra stack: Qwen/Qwen3-Embedding-0.6B (1024 dims) + deepseek-ai/DeepSeek-V4-Flash-0731.
SAG_LLM_PROVIDER=openai
SAG_LLM_BASE_URL=https://api.deepinfra.com/v1/openai
SAG_LLM_API_KEY=
SAG_LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
SAG_LLM_MAX_TOKENS=20000
SAG_LLM_STRUCTURED_OUTPUT_MODE=auto
SAG_LOCK_LLM_CONFIG=false

SAG_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
SAG_EMBEDDING_BASE_URL=https://api.deepinfra.com/v1/openai
SAG_EMBEDDING_API_KEY=
SAG_EMBEDDING_DIMENSIONS=1024
SAG_EMBEDDING_CONCURRENCY=6
SAG_EMBEDDING_TIMEOUT=60
SAG_EMBEDDING_MAX_RETRIES=3

# ── Optional Query Decision Router & Cross-Encoder Reranker ──
# Set SAG_DECISION_PROVIDER=siliconflow once SAG_SILICONFLOW_API_KEY is populated (0ms fail-open if unset).
SAG_DECISION_PROVIDER=disabled
SAG_DECISION_MODEL=Kev-4b
SAG_SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1
SAG_SILICONFLOW_API_KEY=
# DeepInfra Reranker reuses SAG_LLM_API_KEY / DEEPINFRA_API_KEY automatically (safe no-op if key is empty).
SAG_RERANK_PROVIDER=deepinfra
SAG_RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
SAG_RERANK_BASE_URL=
SAG_RERANK_API_KEY=
SAG_USER_MEMORY_MODE=on
SAG_USER_MEMORY_QDRANT_COLLECTION=aiinvest_user_memories
SAG_USER_MEMORY_EXTRACTOR_MODEL=
SAG_USER_MEMORY_WORKER_ENABLED=true
SAG_USER_MEMORY_DEBOUNCE_SECONDS=8.0
# Read-only Core PostgreSQL DSN (`default_transaction_read_only = on`) for catalog/screener & tier batch ingest:
# e.g. postgresql://postgres:<DB_PASSWORD>@localhost:5432/aiinvest
SAG_CORE_DATABASE_URL=

# ── Document Parsing (Smart Hybrid MinerU + Isolated Local Worker) ──
SAG_DOCUMENT_PARSER=auto
SAG_MINERU_PROVIDER=official
SAG_MINERU_BASE_URL=https://mineru.net
# Use `pipeline` + canonical `latin` language mapping for Vietnamese scanned BCTC accuracy.
SAG_MINERU_OFFICIAL_MODEL=vlm
SAG_MINERU_POLL_TIMEOUT=900
SAG_MINERU_PARSE_METHOD=auto
# Supports single token OR Round-Robin multi-token pool (_0, _1, ...) with automatic failover:
SAG_MINERU_OFFICIAL_API_TOKEN=
SAG_MINERU_OFFICIAL_API_TOKEN_0=
SAG_MINERU_OFFICIAL_API_TOKEN_1=
SAG_MINERU_OFFICIAL_API_TOKEN_2=
SAG_MINERU_PER_TOKEN_CONCURRENCY=8

# ── Cloudflare R2 Cleaned Markdown Recovery Cache (`vn-clean-v3`) ──
R2_ACCOUNT_ID=
R2_ENDPOINT_URL=
R2_BUCKET_NAME=aiinvest-bctc-prod
R2_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
SAG_R2_MD_LOCAL_CACHE_DIR=./.data/r2-md-cache

SAG_OBJECT_INGEST_ALLOWED_HOSTS=.r2.cloudflarestorage.com
SAG_OBJECT_INGEST_ALLOW_PRIVATE_HOSTS_IN_DEV=false
SAG_OBJECT_INGEST_TIMEOUT_SECONDS=120
SAG_LOCAL_PARSE_WORKERS=2
SAG_LOCAL_PARSE_TIMEOUT_SECONDS=90
SAG_LOCAL_PARSE_MAX_TASKS_PER_CHILD=25
SAG_MINERU_IO_CONCURRENCY=16
SAG_FAST_PARSE_CONCURRENCY=16
SAG_PER_PROJECT_HEAVY_PARSE_LIMIT=3
SAG_REMOTE_SNAPSHOT_GC_ENABLED=true

# ── Knowledge Routing RAG Pipeline (FOUNDATION Only, No E2 LLM) ────
# Canonical ingestion skips per-chunk Event/Entity LLM extraction (0 ingest LLM calls).
# Option A+ uses the shared Qdrant chamber directly, so background Leiden rebuilds stay OFF.
SAG_DOCUMENT_EVENT_EXTRACTION_ENABLED=false
SAG_KNOWLEDGE_WORKER_ENABLED=true
SAG_KNOWLEDGE_TREE_REBUILD_ENABLED=false
SAG_TIMEZONE=Asia/Ho_Chi_Minh
SAG_KNOWLEDGE_CONCURRENCY=4
SAG_KNOWLEDGE_QUEUE_CAPACITY=256
SAG_KNOWLEDGE_GRAPH_TIMEOUT_SECONDS=300
