# Docker Compose dùng được ngay với giá trị mặc định có sẵn; chỉ cần sao chép file này thành .env khi cần tùy chỉnh.

# ── Cổng ───────────────────────────────────────────────
WEB_PORT=3000
API_PORT=8000
# Mặc định máy này chỉ lắng nghe địa chỉ loopback; triển khai LAN/server đổi thành 0.0.0.0.
BIND_ADDRESS=127.0.0.1

# ── Khởi động nhanh cục bộ ─────────────────────────────
SAG_ENVIRONMENT=dev
SAG_CORS_ORIGINS=http://localhost:3000
# Tắt endpoint đăng ký email truyền thống; dẫn dắt danh tính cục bộ không bị ảnh hưởng.
SAG_ALLOW_REGISTRATION=false
SAG_SAG_LANGUAGE=vi

# Triển khai production phải đặt giá trị ngẫu nhiên mạnh (lệnh sinh: openssl rand -hex 32).
# Bỏ trống khi dev cục bộ, Compose sẽ dùng khóa phát triển chỉ phù hợp cho máy này.
SAG_SECRET_KEY=

# ── Tri thức ngoài Dify (tùy chọn)──────────────────────
# Chỉ chạy `make setup-dify` để tự sinh khi cần kết nối Dify; không commit khóa thật.
SAG_DIFY_API_KEY=
# Chiến lược tìm kiếm riêng cho Dify: vector (mặc định, độ trễ thấp) hoặc multi (mở rộng thực thể + xếp hạng lại bằng LLM, độ trễ cao hơn).
SAG_DIFY_SEARCH_STRATEGY=vector

# Địa chỉ trình duyệt truy cập backend (nội tuyến lúc build; sửa đổi cần build lại web).
NEXT_PUBLIC_API_BASE=http://localhost:8000
# Web mặc định bật phóng to cửa sổ trong trang; khi build desktop client đặt false.
NEXT_PUBLIC_ENABLE_WINDOW_SCALING=true

# ── LLM / Embedding（cũng có thể điền ở trang Settings sau khi khởi động）──
SAG_LLM_PROVIDER=openai
SAG_LLM_BASE_URL=https://api.302ai.cn/v1
SAG_LLM_API_KEY=
SAG_LLM_MODEL=deepseek-ai/DeepSeek-V3
SAG_LLM_MAX_TOKENS=20000

# Model trích xuất Graph riêng (tùy chọn; nếu không điền sẽ dùng SAG_LLM_MODEL)
SAG_EXTRACTION_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# SAG_EXTRACTION_LLM_BASE_URL=https://api.siliconflow.cn/v1
# SAG_EXTRACTION_LLM_API_KEY=

# Các giá trị SAG_LLM_* trên là mặc định khi khởi động lần đầu; sau đó có thể điều chỉnh ở trang Settings và áp dụng ngay.
# Nếu bên triển khai cần khóa cấu hình model sinh, đặt true. Sau khi sửa cấu hình LLM cần khởi động lại dịch vụ.
SAG_LOCK_LLM_CONFIG=false
# Khi nối Anthropic / Gemini gốc, đổi SAG_LLM_PROVIDER sang giá trị tương ứng, Base URL để trống sẽ dùng endpoint chính thức.
SAG_EMBEDDING_MODEL=bge-large-en-v1.5
SAG_EMBEDDING_BASE_URL=https://api.302ai.cn/v1
SAG_EMBEDDING_API_KEY=

# ── Phân tích tài liệu（PDF ưu tiên MinerU；chưa cấu hình hoặc lỗi sẽ fallback MarkItDown）────
SAG_DOCUMENT_PARSER=auto
SAG_MINERU_BASE_URL=https://api.302ai.cn
SAG_MINERU_API_KEY=
SAG_MINERU_VERSION=2.5

# ── Override Postgres production（compose.postgres.yaml）───────────
POSTGRES_USER=sag
# Bắt buộc khi dùng override production; gợi ý: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=sag

# ── Độ ổn định（tùy chọn，bỏ comment để áp dụng）──────────────────────
# SAG_JOB_MAX_ATTEMPTS=3
# SAG_ENGINE_CACHE_SIZE=16
# SAG_ENGINE_WARMUP_COUNT=4
# SAG_MINERU_POLL_TIMEOUT=300
