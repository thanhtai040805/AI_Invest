# =================================================================
# SAG PRODUCTION ENVIRONMENT CONFIGURATION (.env.prod)
# =================================================================

# ── 1. Ứng dụng & Bảo mật ─────────────────────────────────────────
SAG_ENVIRONMENT=prod
SAG_DEBUG=false
SAG_SECRET_KEY=change-this-to-a-very-secure-random-32-character-secret-key
SAG_CORS_ORIGINS=https://aiinvest.vn,https://app.aiinvest.vn
SAG_ALLOW_REGISTRATION=false
SAG_TIMEZONE=Asia/Ho_Chi_Minh
SAG_SAG_LANGUAGE=vi

# ── 2. Cơ sở dữ liệu Metadata SAG (PostgreSQL) ─────────────────────
# URL kết nối PostgreSQL cho Metadata (Users, Documents, Sources, Jobs)
SAG_DATABASE_URL=postgresql+asyncpg://sag_user:sag_password@localhost:5432/sag_prod

# ── 3. Lưu trữ Engine & Uploads ───────────────────────────────────
SAG_DATA_DIR=/var/data/sag/engine
SAG_UPLOAD_DIR=/var/data/sag/uploads
SAG_MAX_UPLOAD_MB=50

# ── 4. zleap-sag Engine Backend (PostgreSQL + pgvector) ───────────
# Bắt buộc chuyển từ lancedb sang pgvector + postgres khi lên PROD
SAG_SAG_VECTOR_PROVIDER=pgvector
SAG_SAG_RELATIONAL_PROVIDER=postgres
SAG_SAG_PG_HOST=localhost
SAG_SAG_PG_PORT=5432
SAG_SAG_PG_USER=sag_user
SAG_SAG_PG_PASSWORD=sag_password
SAG_SAG_PG_DATABASE=sag_prod

# ── 5. LLM & Embedding Models ──────────────────────────────────────
SAG_LLM_PROVIDER=openai
SAG_LLM_BASE_URL=https://api.siliconflow.com/v1
SAG_LLM_API_KEY=sk-your-siliconflow-api-key
SAG_EXTRACTION_LLM_MODEL=openai/deepseek-ai/DeepSeek-V4-Flash

SAG_AGENT_LLM_MODEL=openai/deepseek-ai/DeepSeek-V4-Flash-0731
SAG_AGENT_LLM_API_KEY=sk-your-agent-llm-api-key

SAG_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
SAG_EMBEDDING_BASE_URL=https://api.siliconflow.com/v1
SAG_EMBEDDING_API_KEY=sk-your-embedding-api-key
SAG_EMBEDDING_DIMENSIONS=4096

# ── 6. Cấu hình Tác vụ & Concurrency ──────────────────────────────
SAG_JOB_CONCURRENCY=8
SAG_DOCUMENT_EXTRACT_CONCURRENCY=10
SAG_DOCUMENT_CHUNK_MAX_TOKENS=100000
SAG_DOCUMENT_CHUNK_MODE=standard
SAG_DOCUMENT_STRICT_FILTERING=true
SAG_SEARCH_STRATEGY=multi
SAG_SEARCH_TOP_K=8
