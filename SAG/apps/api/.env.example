# ── Ứng dụng ───────────────────────────────────────────
SAG_ENVIRONMENT=dev
SAG_DEBUG=true
# Production bắt buộc thay bằng giá trị ngẫu nhiên mạnh
SAG_SECRET_KEY=dev-secret-change-me-at-least-32-bytes
# Phân cách bằng dấu phẩy; môi trường dev còn tự cho phép IP LAN（192.168.x.x…）
SAG_CORS_ORIGINS=http://localhost:3000
# Khi tắt chỉ cho phép user đầu tiên đăng ký（hướng dẫn triển khai），còn lại 403
SAG_ALLOW_REGISTRATION=true
# Múi giờ IANA; timestamp DB/API vẫn thống nhất theo UTC
SAG_TIMEZONE=Asia/Ho_Chi_Minh
SAG_SAG_LANGUAGE=vi

# ── Cơ sở dữ liệu meta sag（mặc định SQLite không phụ thuộc）────────────────
SAG_DATABASE_URL=sqlite+aiosqlite:///./.data/sag.db
# Production（Postgres）：postgresql+asyncpg://sag:sag@db:5432/sag

# ── Lưu trữ ───────────────────────────────────────────────
SAG_DATA_DIR=./.data/engine
SAG_UPLOAD_DIR=./.data/uploads
SAG_MAX_UPLOAD_MB=25

# ── Tác vụ nền và engine（độ ổn định）─────────────────────────────
SAG_JOB_CONCURRENCY=2          # Số lượng xử lý đồng thời
SAG_DOCUMENT_EXTRACT_CONCURRENCY=5  # Độ đồng thời trích xuất chunk mỗi tài liệu
SAG_DOCUMENT_CHUNK_MAX_TOKENS=1000  # Số token tối đa mỗi đoạn cắt
SAG_DOCUMENT_CHUNK_MODE=standard    # standard / heading_strict
SAG_DOCUMENT_STRICT_FILTERING=false # Lọc tương đối chặt theo tiêu đề/tóm tắt; sách, báo cáo mặc định tắt
SAG_JOB_MAX_ATTEMPTS=3         # Số lần thử tối đa cho lỗi có thể retry（backoff lũy thừa）
SAG_ENGINE_CACHE_SIZE=16       # Giới hạn LRU slot engine（vượt hạn đẩy ra cái lâu nhất chưa dùng）
SAG_ENGINE_WARMUP_COUNT=4      # Số engine nguồn dùng gần đây được làm nóng lúc khởi động
# Danh sách trắng extension upload là mặc định tích hợp（md/txt/pdf/docx/pptx/xlsx/csv/html/json/hình ảnh…）

# ── Vũ trụ tri thức（khám phá tiến dần ưu tiên thực thể）──────────────────────
SAG_UNIVERSE_ENTITY_PAGE_SIZE=24  # Số thực thể hiện ra mỗi lần lại gần nguồn thông tin
SAG_UNIVERSE_ENTITY_PAGE_MAX=48   # Trần cứng mỗi lần gọi
SAG_UNIVERSE_TIMELINE_EVENT_PAGE_SIZE=8      # Số sự kiện hiện ra mỗi lần kéo gần
SAG_UNIVERSE_EVENT_ENTITY_LIMIT=96           # Giới hạn an toàn thực thể mỗi sự kiện; sự kiện bình thường trả về đầy đủ
SAG_UNIVERSE_AUTO_PAGE_LIMIT=4    # Số trang tối đa tự động thu phóng tiến vào

# ── Backend zleap-sag（mặc định LanceDB không phụ thuộc）───────────────
SAG_SAG_VECTOR_PROVIDER=lancedb
# Khi production dùng một DB（pgvector）：
# SAG_SAG_VECTOR_PROVIDER=pgvector
# SAG_SAG_RELATIONAL_PROVIDER=postgres
# SAG_SAG_PG_HOST=db
# SAG_SAG_PG_PORT=5432
# SAG_SAG_PG_USER=sag
# SAG_SAG_PG_PASSWORD=sag
# SAG_SAG_PG_DATABASE=sag
SAG_SAG_LANGUAGE=vi

# ── LLM（OpenAI-compatible / Anthropic / Gemini）──────────────
# Chưa cấu hình vẫn khởi động được dịch vụ và upload tài liệu, nhưng trích xuất/QA không dùng được
SAG_LLM_PROVIDER=openai       # openai / anthropic / gemini
SAG_LLM_BASE_URL=https://api.302ai.cn/v1
SAG_LLM_API_KEY=
SAG_LLM_MODEL=qwen3.6-flash
SAG_LLM_TEMPERATURE=0.3
SAG_LLM_MAX_TOKENS=20000
SAG_LLM_TIMEOUT_MS=60000
SAG_LLM_MAX_RETRIES=2
# Provider gốc để trống Base URL tức dùng endpoint chính thức. Ví dụ Anthropic：
# SAG_LLM_PROVIDER=anthropic
# SAG_LLM_BASE_URL=
# SAG_LLM_MODEL=claude-sonnet-5
# Ví dụ Gemini：
# SAG_LLM_PROVIDER=gemini
# SAG_LLM_BASE_URL=
# SAG_LLM_MODEL=gemini-3.5-flash

# ── Embedding（mặc định tái dùng key / base_url của LLM）────────
SAG_EMBEDDING_MODEL=bge-large-en-v1.5
SAG_EMBEDDING_BASE_URL=https://api.302ai.cn/v1
SAG_EMBEDDING_API_KEY=
# SAG_EMBEDDING_DIMENSIONS=1024

# ── Phân tích tài liệu（PDF ưu tiên MinerU；thiếu Key tự fallback MarkItDown）────
SAG_DOCUMENT_PARSER=auto
SAG_MINERU_BASE_URL=https://api.302ai.cn
SAG_MINERU_API_KEY=
SAG_MINERU_VERSION=2.5

# ── Mặc định truy vấn ───────────────────────────────────────────
SAG_SEARCH_STRATEGY=multi
SAG_SEARCH_TOP_K=8
SAG_SEARCH_SOURCE_CANDIDATE_LIMIT=16
SAG_SEARCH_SOURCE_CONCURRENCY=4

# ── Ngưỡng camera vũ trụ tri thức và ngân sách trình duyệt ──────────────────────
SAG_UNIVERSE_LOD_ORBIT_PX=72
SAG_UNIVERSE_LOD_NEAR_PX=180
SAG_UNIVERSE_LOD_DEEP_PX=360
SAG_UNIVERSE_NODE_BUDGET_DESKTOP=2000
SAG_UNIVERSE_EDGE_BUDGET_DESKTOP=5000
