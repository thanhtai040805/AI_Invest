# ── Application & Auth ───────────────────────────────────────────────────────
SAG_ENVIRONMENT=dev
SAG_DEBUG=true
# Dev placeholder only; production startup rejects empty, <32-byte, or known default secrets.
SAG_SECRET_KEY=dev-insecure-secret-change-me-in-production-0123456789
# Comma-separated CORS origins; dev also allows localhost and private LAN origins.
SAG_CORS_ORIGINS=http://localhost:3000
# continuum + SAG_BFF_SERVICE_TOKEN enables standalone project-scoped ingest & search
# via /api/v1/projects/{ticker}/documents/* and /api/v1/auth/continuum-login (no external JWKS required).
SAG_AUTH_MODE=continuum
SAG_BFF_SERVICE_TOKEN=aiinvest-sag-bff-dev-token-change-me-32bytes
# SAG user IDs allowed to change shared model settings in password/continuum mode.
SAG_MODEL_CONFIG_OPERATOR_IDS=
SAG_ALLOW_REGISTRATION=false
# IANA timezone for display; database and API timestamps remain UTC.
SAG_TIMEZONE=Asia/Ho_Chi_Minh

# ── Optional External Principal Assertion (RS256 JWKS) ───────────────────────
# Uncomment only if integrating an external RS256 JWKS identity provider.
# SAG_PRINCIPAL_ASSERTION_ISSUER=
# SAG_PRINCIPAL_ASSERTION_AUDIENCE=sag-api
# SAG_PRINCIPAL_ASSERTION_JWKS_URL=
# SAG_PRINCIPAL_ASSERTION_MAX_LIFETIME_SECONDS=120
# SAG_PRINCIPAL_ASSERTION_CLOCK_SKEW_SECONDS=5
# SAG_PRINCIPAL_ASSERTION_JWKS_CACHE_TTL_SECONDS=60
# SAG_PRINCIPAL_ASSERTION_MAX_PROJECT_IDS=256

# ── Optional Query Decision Router & Cross-Encoder Reranker ──────────────────
# SiliconFlow Kev-4b activates automatically once SAG_SILICONFLOW_API_KEY is populated (0ms fail-open if unset).
SAG_DECISION_MODEL=Kev-4b
SAG_SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1
SAG_SILICONFLOW_API_KEY=
# DeepInfra Reranker reuses SAG_LLM_API_KEY / DEEPINFRA_API_KEY automatically (safe no-op if key is empty).
SAG_RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
SAG_RERANK_BASE_URL=
SAG_RERANK_API_KEY=
SAG_USER_MEMORY_QDRANT_COLLECTION=aiinvest_user_memories
SAG_USER_MEMORY_EXTRACTOR_MODEL=
SAG_USER_MEMORY_WORKER_ENABLED=true
SAG_USER_MEMORY_DEBOUNCE_SECONDS=8.0
# Read-only Core PostgreSQL DSN (`default_transaction_read_only = on`) for catalog/screener & tier batch ingest:
# e.g. postgresql://postgres:<DB_PASSWORD>@localhost:5432/aiinvest
SAG_CORE_DATABASE_URL=

# ── Metadata Database (PostgreSQL 16 — Isolated from Thesis 'sag') ───────────
SAG_DATABASE_URL=postgresql+asyncpg://aiinvest_sag:aiinvest_sag@127.0.0.1:55432/aiinvest_sag
# Zero-dependency local fallback: sqlite+aiosqlite:///./.data/sag.db

# ── Local Runtime Directories ────────────────────────────────────────────────
SAG_DATA_DIR=./.data/engine
SAG_UPLOAD_DIR=./.data/uploads
SAG_MAX_UPLOAD_MB=25

# ── Knowledge Routing RAG Pipeline (FOUNDATION + Intra-Ticker Unit Graph, 0 Ingest LLM Calls) ────
SAG_KNOWLEDGE_WORKER_ENABLED=true
SAG_KNOWLEDGE_CONCURRENCY=4
SAG_KNOWLEDGE_QUEUE_CAPACITY=256
SAG_KNOWLEDGE_GRAPH_TIMEOUT_SECONDS=300
SAG_JOB_CONCURRENCY=4
SAG_DOCUMENT_EXTRACT_CONCURRENCY=6
SAG_DOCUMENT_CHUNK_MAX_TOKENS=1000
SAG_DOCUMENT_CHUNK_MODE=standard
SAG_DOCUMENT_STRICT_FILTERING=false
SAG_JOB_MAX_ATTEMPTS=3
SAG_ENGINE_CACHE_SIZE=16
SAG_ENGINE_WARMUP_COUNT=4

# ── zleap-sag Storage Backends (PostgreSQL 16 + Qdrant) ─────────────────────
SAG_SAG_VECTOR_PROVIDER=qdrant
SAG_SAG_RELATIONAL_PROVIDER=postgres
SAG_SAG_QDRANT_URL=http://127.0.0.1:16333
SAG_SAG_QDRANT_API_KEY=
SAG_SAG_QDRANT_SHARED_COLLECTION=aiinvest_search_units
SAG_SAG_QDRANT_ON_DISK=true
SAG_SAG_QDRANT_SCALAR_QUANTIZATION=true
SAG_SAG_PG_HOST=127.0.0.1
SAG_SAG_PG_PORT=55432
SAG_SAG_PG_USER=aiinvest_sag
SAG_SAG_PG_PASSWORD=aiinvest_sag
SAG_SAG_PG_DATABASE=aiinvest_sag
SAG_SAG_LANGUAGE=vi

# ── LLM (Answer Synthesis / Optional Online Rerank — DeepInfra) ──────────────
SAG_LLM_PROVIDER=openai
SAG_LLM_BASE_URL=https://api.deepinfra.com/v1/openai
SAG_LLM_API_KEY=
SAG_LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash
SAG_LLM_TEMPERATURE=0.3
SAG_LLM_MAX_TOKENS=20000
SAG_LLM_TIMEOUT_MS=60000
SAG_LLM_MAX_RETRIES=2
SAG_LLM_STRUCTURED_OUTPUT_MODE=auto
SAG_LOCK_LLM_CONFIG=false

# ── Embedding (Shared Cache, 1024 dims — DeepInfra) ──────────────────────────
SAG_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
SAG_EMBEDDING_BASE_URL=https://api.deepinfra.com/v1/openai
SAG_EMBEDDING_API_KEY=
SAG_EMBEDDING_DIMENSIONS=1024
SAG_EMBEDDING_CONCURRENCY=6
SAG_EMBEDDING_TIMEOUT=60
SAG_EMBEDDING_MAX_RETRIES=3

# ── Document Parsing (Smart Hybrid MinerU Official v4 + Isolated Worker) ────
SAG_DOCUMENT_PARSER=auto
SAG_MINERU_PROVIDER=official
SAG_MINERU_BASE_URL=https://mineru.net
SAG_MINERU_OFFICIAL_MODEL=vlm
SAG_MINERU_POLL_TIMEOUT=900
SAG_MINERU_PARSE_METHOD=auto
# Supports single token OR Round-Robin multi-token pool (_0, _1, ...) with automatic failover:
SAG_MINERU_OFFICIAL_API_TOKEN=
SAG_MINERU_OFFICIAL_API_TOKEN_0=
SAG_MINERU_OFFICIAL_API_TOKEN_1=
SAG_MINERU_OFFICIAL_API_TOKEN_2=
SAG_MINERU_PER_TOKEN_CONCURRENCY=8

# ── Cloudflare R2 Cleaned Markdown Recovery Cache (`vn-clean-v3`) ────────────
R2_ACCOUNT_ID=
R2_ENDPOINT_URL=
R2_BUCKET_NAME=aiinvest-bctc-prod
R2_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
SAG_R2_MD_LOCAL_CACHE_DIR=./.data/r2-md-cache
SAG_OBJECT_INGEST_ALLOWED_HOSTS=.r2.cloudflarestorage.com
SAG_OBJECT_INGEST_ALLOW_PRIVATE_HOSTS_IN_DEV=false
SAG_OBJECT_INGEST_TIMEOUT_SECONDS=120
SAG_LOCAL_PARSE_WORKERS=2
SAG_LOCAL_PARSE_TIMEOUT_SECONDS=90
SAG_LOCAL_PARSE_MAX_TASKS_PER_CHILD=25

# ── Adaptive Retrieval Defaults ──────────────────────────────────────────────
SAG_SEARCH_STRATEGY=multi
SAG_SEARCH_TOP_K=8
SAG_SEARCH_SOURCE_CANDIDATE_LIMIT=0
SAG_SEARCH_SOURCE_CONCURRENCY=4
SAG_SEARCH_UNIT_CANDIDATE_LIMIT=1024
SAG_SEARCH_RERANK_MIN_REMAINING_SECONDS=0.1
SAG_SEARCH_TREE_PROFILE_LIMIT=8192
SAG_SEARCH_TREE_ESCAPE_RESERVE_SECONDS=1.5
SAG_SEARCH_TREE_SNAPSHOT_TIMEOUT=3.0
SAG_SEARCH_MMR_DIVERSITY_WEIGHT=0.5
SAG_SEARCH_NEAR_DUPLICATE_SIMILARITY=0.98

# ── Knowledge Universe View Budgets (within validated Settings bounds) ───────
SAG_UNIVERSE_TIMELINE_EVENT_PAGE_SIZE=20
SAG_UNIVERSE_EVENT_ENTITY_LIMIT=8
SAG_UNIVERSE_LOD_ORBIT_PX=72
SAG_UNIVERSE_LOD_NEAR_PX=180
SAG_UNIVERSE_LOD_DEEP_PX=360
SAG_UNIVERSE_NODE_BUDGET_DESKTOP=700
SAG_UNIVERSE_EDGE_BUDGET_DESKTOP=1000
