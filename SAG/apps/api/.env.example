# ── 应用 ───────────────────────────────────────────────
SAG_ENVIRONMENT=dev
SAG_DEBUG=true

# ── Kev-4B Decision Router (SiliconFlow) ───────────────────────────────
SAG_DECISION_PROVIDER=siliconflow
SAG_DECISION_MODEL=Kev-4b
SAG_SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1
SAG_SILICONFLOW_API_KEY=
# 生产务必替换为强随机值
SAG_SECRET_KEY=dev-secret-change-me-at-least-32-bytes
# 逗号分隔；dev 环境还会自动放行局域网 IP（192.168.x.x 等）
SAG_CORS_ORIGINS=http://localhost:3002
# local：本机名字身份；password：强制邮箱密码登录
SAG_AUTH_MODE=local
# SAG user IDs allowed to change shared model settings in password/continuum mode.
# Empty denies model tests, model updates, and shared model setup for those modes.
SAG_MODEL_CONFIG_OPERATOR_IDS=
# 仅 password 模式生效；关闭后只允许建立首个正式凭据
SAG_ALLOW_REGISTRATION=true
# IANA 时区；数据库/API 时间戳仍统一为 UTC
SAG_TIMEZONE=Asia/Shanghai

# ── Continuum principal assertion / evidence ACL ──────────────
# Configure the matching Continuum issuer and its fixed HTTPS JWKS endpoint.
# The trusted BFF sends the signed assertion only server-to-server; missing config fails closed.
SAG_PRINCIPAL_ASSERTION_ISSUER=
SAG_PRINCIPAL_ASSERTION_AUDIENCE=sag-api
SAG_PRINCIPAL_ASSERTION_JWKS_URL=
SAG_PRINCIPAL_ASSERTION_MAX_LIFETIME_SECONDS=120
SAG_PRINCIPAL_ASSERTION_CLOCK_SKEW_SECONDS=5
SAG_PRINCIPAL_ASSERTION_JWKS_CACHE_TTL_SECONDS=60
SAG_PRINCIPAL_ASSERTION_MAX_PROJECT_IDS=256

# ── sag 元数据库（Postgres）────────────────────────────
SAG_DATABASE_URL=postgresql+asyncpg://sag:sag@localhost:5432/sag
# 本地零依赖 fallback：sqlite+aiosqlite:///./.data/sag.db

# ── 存储 ───────────────────────────────────────────────
SAG_DATA_DIR=./.data/engine
SAG_UPLOAD_DIR=./.data/uploads
SAG_MAX_UPLOAD_MB=25

# ── 后台任务与引擎（稳定性）─────────────────────────────
SAG_JOB_CONCURRENCY=4          # 处理并发
SAG_DOCUMENT_EXTRACT_CONCURRENCY=6  # 每个文档的 chunk 抽取并发
SAG_EMBEDDING_CONCURRENCY=6         # 每引擎 embedding HTTP 并发；llama.cpp --parallel 1 时应设为 1
SAG_EMBEDDING_TIMEOUT=60            # embedding 单次请求超时（秒）
SAG_DOCUMENT_CHUNK_MAX_TOKENS=1000  # 每个切片的最大 token 数
SAG_DOCUMENT_CHUNK_MODE=standard    # standard / heading_strict
SAG_DOCUMENT_STRICT_FILTERING=false # 标题/摘要严格相关性过滤；书籍、报告默认关闭
SAG_JOB_MAX_ATTEMPTS=3         # 可重试失败的最大尝试次数（指数退避）
SAG_ENGINE_CACHE_SIZE=16       # 引擎槽 LRU 上限（超限逐出最久未用）
SAG_ENGINE_WARMUP_COUNT=4      # 启动时预热最近使用的信源引擎数
# 上传扩展名白名单为内置默认（md/txt/pdf/docx/pptx/xlsx/csv/html/json/图片…）

# ── 知识宇宙（实体优先的渐进探索）──────────────────────
SAG_UNIVERSE_ENTITY_PAGE_SIZE=24  # 每次靠近信息源显现的实体数
SAG_UNIVERSE_ENTITY_PAGE_MAX=48   # 单次接口硬上限
SAG_UNIVERSE_TIMELINE_EVENT_PAGE_SIZE=8      # 每次拉近显现的事件数
SAG_UNIVERSE_EVENT_ENTITY_LIMIT=96           # 单事件实体安全上限；正常事件完整返回
SAG_UNIVERSE_AUTO_PAGE_LIMIT=4    # 自动缩放最多推进的页数

# ── zleap-sag 后端（Postgres + Qdrant）────────────────
SAG_SAG_VECTOR_PROVIDER=qdrant
SAG_SAG_RELATIONAL_PROVIDER=postgres
SAG_SAG_QDRANT_URL=http://localhost:6333
SAG_SAG_QDRANT_API_KEY=
SAG_SAG_PG_HOST=localhost
SAG_SAG_PG_PORT=5432
SAG_SAG_PG_USER=sag
SAG_SAG_PG_PASSWORD=sag
SAG_SAG_PG_DATABASE=sag
SAG_SAG_LANGUAGE=en

# ── LLM（OpenAI-compatible / Anthropic / Gemini）──────────────
# 未配置时可启动服务与上传文档，但抽取/问答不可用
SAG_LLM_PROVIDER=openai       # openai / anthropic / gemini
SAG_LLM_BASE_URL=https://api.302ai.cn/v1
SAG_LLM_API_KEY=
SAG_LLM_MODEL=qwen3.6-flash
SAG_LLM_TEMPERATURE=0.3
SAG_LLM_MAX_TOKENS=20000
SAG_LLM_TIMEOUT_MS=60000
SAG_LLM_MAX_RETRIES=2
# 原生 provider 留空 Base URL 即使用官方端点。Anthropic 示例：
# SAG_LLM_PROVIDER=anthropic
# SAG_LLM_BASE_URL=
# SAG_LLM_MODEL=claude-sonnet-5
# Gemini 示例：
# SAG_LLM_PROVIDER=gemini
# SAG_LLM_BASE_URL=
# SAG_LLM_MODEL=gemini-3.5-flash

# ── Embedding（缺省复用 LLM 的 key / base_url）────────
SAG_EMBEDDING_MODEL=bge-large-en-v1.5
SAG_EMBEDDING_BASE_URL=https://api.302ai.cn/v1
SAG_EMBEDDING_API_KEY=
# SAG_EMBEDDING_DIMENSIONS=1024

# ── 文档解析（PDF 优先 MinerU；无 Key 时自动回退 MarkItDown）────
SAG_DOCUMENT_PARSER=auto
# 302 使用下方默认地址；official 使用 https://mineru.net 与官方 API Token。
SAG_MINERU_PROVIDER=official
SAG_MINERU_BASE_URL=https://mineru.net
SAG_MINERU_OFFICIAL_MODEL=vlm
SAG_MINERU_PARSE_METHOD=auto
SAG_MINERU_OFFICIAL_API_TOKEN=

# ── 检索默认 ───────────────────────────────────────────
SAG_SEARCH_STRATEGY=multi
SAG_SEARCH_TOP_K=8
SAG_SEARCH_SOURCE_CANDIDATE_LIMIT=16
SAG_SEARCH_SOURCE_CONCURRENCY=4
SAG_SEARCH_UNIT_CANDIDATE_LIMIT=1024
SAG_SEARCH_RERANK_MIN_REMAINING_SECONDS=0.1
SAG_SEARCH_TREE_PROFILE_LIMIT=8192
SAG_SEARCH_TREE_ESCAPE_RESERVE_SECONDS=1.5
SAG_SEARCH_TREE_SNAPSHOT_TIMEOUT=1.0
SAG_SEARCH_MMR_DIVERSITY_WEIGHT=0.5
SAG_SEARCH_NEAR_DUPLICATE_SIMILARITY=0.98

# ── 知识宇宙镜头阈值与浏览器预算 ──────────────────────
SAG_UNIVERSE_LOD_ORBIT_PX=72
SAG_UNIVERSE_LOD_NEAR_PX=180
SAG_UNIVERSE_LOD_DEEP_PX=360
SAG_UNIVERSE_NODE_BUDGET_DESKTOP=2000
SAG_UNIVERSE_EDGE_BUDGET_DESKTOP=5000
