# Địa chỉ API backend（trình duyệt kết nối trực tiếp, backend dev đã tự động cho phép CORS qua LAN）
# Khi truy cập qua http://192.168.x.x:3000, có thể để trống hoặc giữ localhost, frontend tự đổi sang cùng IP:8000
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Web mặc định cung cấp phóng to cửa sổ trong trang; khi build desktop client đặt false.
NEXT_PUBLIC_ENABLE_WINDOW_SCALING=true
