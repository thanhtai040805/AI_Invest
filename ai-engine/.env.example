# DNSE Lightspeed Open API
DNSE_ENABLED=true
DNSE_API_KEY=your-api-key-from-entradex
DNSE_API_SECRET=your-api-secret-one-time-display
DNSE_ACCOUNT_NO=0003979888
DNSE_BASE_URL=https://openapi.dnse.com.vn
DNSE_WS_URL=wss://ws-openapi.dnse.com.vn

# WebSocket Settings
DNSE_BOARD_ID=G1
DNSE_ENCODING=msgpack

# Redis pub/sub → Node backend Socket.IO relay
REDIS_URL=redis://localhost:6379
# Production: REDIS_URL=redis://:your_redis_password@redis:6379
DNSE_REDIS_CHANNEL_PREFIX=dnse:event

# AI / LLM Providers — Multi-Tier Failover Architecture
# 1. Groq Model Rotation: openai/gpt-oss-120b -> openai/gpt-oss-20b -> qwen/qwen3.8-27b (0 VND)
# 2. EvoMap Fallback: evomap-deepseek-v4-flash
GROQ_API_KEY0=
GROQ_MODEL0=openai/gpt-oss-120b

GROQ_API_KEY1=
GROQ_MODEL1=openai/gpt-oss-20b

VIMO_API_KEY=

EVOMAP_API_KEY=

# ==============================================================================
# AI INVEST HOSE QUANT & MULTI-AGENT EXECUTION MODES (IOS v5.1)
# ==============================================================================
# Options: LIVE | SHADOW_RUNNER | DISABLED
# Multi-Agent Book: Runs in Shadow Mode (paper trading & DB logging, no broker execution)
MULTI_AGENT_ACCOUNT_ID=940b0c70-2010-42f3-b947-797e6419b794
MULTI_AGENT_MODE=SHADOW_RUNNER

# Standalone Pure-ML Fund: Autonomous Stacking ML Channel (20% NAV / position)
STANDALONE_ML_ACCOUNT_ID=standalone-pure-ml-fund-account
STANDALONE_ML_MODE=SHADOW_RUNNER
STANDALONE_ML_POSITION_WEIGHT=0.20

# Portfolio NAV Sizing Defaults (VND)
MULTI_AGENT_INITIAL_NAV=1000000000.0
STANDALONE_ML_INITIAL_NAV=500000000.0

# Required by every /api/admin endpoint outside tests
AI_ENGINE_ADMIN_TOKEN=generate-a-strong-random-string-here

# ==============================================================================
# CLOUDFLARE R2 DATA LAKE (S3 & REST API COMPATIBLE)
# ==============================================================================
R2_ACCOUNT_ID=
R2_ENDPOINT_URL=
# Buckets convention:
#   LOCAL & PROD: aiinvest-bctc-prod (Khai thác chung kho BCTC thật và tài liệu chuẩn sạch)
#   TEST / CI:    aiinvest-bctc-test (Cách ly tự động cho test suite)
R2_BUCKET_NAME=aiinvest-bctc-prod
R2_TEST_BUCKET_NAME=aiinvest-bctc-test
# Cách 1: Dùng Cloudflare API Token (Chỉ cần 1 dòng này)
R2_TOKEN=
# Cách 2: Dùng S3 Credentials
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ==============================================================================
# SAG OCR & FORENSIC CONCURRENCY CONTROLS (OPTIONAL / RESEARCH PROFILE)
# ==============================================================================
SAG_API_BASE=http://localhost:8002/api/v2
SAG_JOB_CONCURRENCY=2
SAG_OCR_ACTIVE_JOBS=4
SAG_OCR_UPLOAD_CONCURRENCY=4
SAG_BENCHMARK_TICKER_CONCURRENCY=2
MINERU_KEY_CONCURRENCY=5
MINERU_SUBMIT_RPM=240
