# DNSE Lightspeed Open API
DNSE_ENABLED=true
DNSE_API_KEY=your-api-key-from-entradex
DNSE_API_SECRET=your-api-secret-one-time-display
DNSE_ACCOUNT_NO=0003979888
DNSE_BASE_URL=https://openapi.dnse.com.vn
DNSE_WS_URL=wss://ws-openapi.dnse.com.vn

# WebSocket Settings
DNSE_BOARD_ID=G1
DNSE_ENCODING=msgpack

# Redis pub/sub → Node backend Socket.IO relay
REDIS_URL=redis://localhost:6379
# Production: REDIS_URL=redis://:your_redis_password@redis:6379
DNSE_REDIS_CHANNEL_PREFIX=dnse:event

# AI / LLM Providers - 4-Provider Architecture
# Gemini: Document reader/analyst for long content (reports, news, filings)
NVDIA=
NVIDIA_MODEL=minimaxai/minimax-m2.7


# OpenRouter: Routing/fallback gateway for model experimentation
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=qwen/qwen3-coder:free

# Groq: Fast realtime tasks (signal scoring, quick classification)
GROQ_API_KEY0=
GROQ_MODEL0=qwen/qwen3-32b

GROQ_API_KEY1=
GROQ_MODEL1=qwen/qwen3-32b

VN_STOCK_KEY=
VIMO_API_KEY=

HUGGING_FACE=

# vnstock (passed to AI engine)
VNSTOCK_API_KEY=

EVOMAP_API_KEY=

# ==============================================================================
# AI INVEST HOSE QUANT & MULTI-AGENT EXECUTION MODES (IOS v5.1)
# ==============================================================================
# Options: LIVE | SHADOW_RUNNER | DISABLED
# Multi-Agent Book: Runs in Shadow Mode (paper trading & DB logging, no broker execution)
MULTI_AGENT_MODE=SHADOW_RUNNER

# Standalone Pure-ML Fund: Runs in LIVE Mode (20% NAV / position)
STANDALONE_ML_MODE=LIVE

# Portfolio NAV Sizing Defaults (VND)
MULTI_AGENT_INITIAL_NAV=1000000000.0
STANDALONE_ML_INITIAL_NAV=500000000.0