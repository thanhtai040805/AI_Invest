# DNSE Lightspeed Open API
DNSE_ENABLED=true
DNSE_API_KEY=your-api-key-from-entradex
DNSE_API_SECRET=your-api-secret-one-time-display
DNSE_ACCOUNT_NO=0003979888
DNSE_BASE_URL=https://openapi.dnse.com.vn
DNSE_WS_URL=wss://ws-openapi.dnse.com.vn

# WebSocket Settings
DNSE_BOARD_ID=G1
DNSE_ENCODING=msgpack

# Redis pub/sub → Node backend Socket.IO relay
REDIS_URL=redis://localhost:6379
# Production: REDIS_URL=redis://:your_redis_password@redis:6379
DNSE_REDIS_CHANNEL_PREFIX=dnse:event

# AI / LLM Providers - 4-Provider Architecture
# Gemini: Document reader/analyst for long content (reports, news, filings)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# OpenAI: Reasoning/judge for stable synthesis and final decisions
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# OpenRouter: Routing/fallback gateway for model experimentation
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=deepseek/deepseek-v4-flash:free

# Groq: Fast realtime tasks (signal scoring, quick classification)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama3-70b-8192
