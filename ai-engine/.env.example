# DNSE Lightspeed Open API
DNSE_ENABLED=true
DNSE_API_KEY=your-api-key-from-entradex
DNSE_API_SECRET=your-api-secret-one-time-display
DNSE_ACCOUNT_NO=0003979888
DNSE_BASE_URL=https://openapi.dnse.com.vn
DNSE_WS_URL=wss://ws-openapi.dnse.com.vn

# WebSocket Settings
DNSE_BOARD_ID=G1
DNSE_ENCODING=msgpack

# Redis pub/sub → Node backend Socket.IO relay
REDIS_URL=redis://localhost:6379
# Production: REDIS_URL=redis://:your_redis_password@redis:6379
DNSE_REDIS_CHANNEL_PREFIX=dnse:event

# AI / LLM
GEMINI=
OPENAI=
OPENROUTER=
GROQ=
