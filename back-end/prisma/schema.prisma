generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  displayName  String?  @map("display_name")
  cashBalance  Decimal  @default(1000000000) @map("cash_balance") @db.Decimal(18, 2)
  createdAt    DateTime @default(now()) @map("created_at")

  positions     Position[]
  orders        Order[]
  chatSessions  ChatSession[]
  alerts        Alert[]
  presets       ScreenerPreset[]
  chartDrawings ChartDrawing[]
  watchlists    Watchlist[]

  @@map("users")
}

model Stock {
  symbol    String   @id
  name      String
  exchange  String   // HOSE, HNX, UPCOM
  industry  String?
  marketCap BigInt?  @map("market_cap")
  ceiling   Decimal? @db.Decimal(12, 2)
  floor     Decimal? @db.Decimal(12, 2)
  refPrice  Decimal? @map("ref_price") @db.Decimal(12, 2)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  positions Position[]
  orders    Order[]

  @@map("stocks")
}

model Position {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  symbol    String
  quantity  Int
  avgPrice  Decimal  @map("avg_price") @db.Decimal(12, 2)
  openedAt  DateTime @default(now()) @map("opened_at")

  user  User  @relation(fields: [userId], references: [id])
  stock Stock @relation(fields: [symbol], references: [symbol])

  @@map("positions")
}

model Order {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  symbol    String
  side      String   // BUY, SELL
  orderType String   @map("order_type") // LO, ATO, ATC, MP
  price     Decimal? @db.Decimal(12, 2)
  quantity  Int
  status    String   @default("PENDING") // PENDING, FILLED, CANCELLED
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id])
  stock Stock @relation(fields: [symbol], references: [symbol])

  @@map("orders")
}

model ChatSession {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String?
  createdAt DateTime @default(now()) @map("created_at")

  user     User          @relation(fields: [userId], references: [id])
  messages ChatMessage[]

  @@map("chat_sessions")
}

model ChatMessage {
  id        String   @id @default(uuid())
  sessionId String   @map("session_id")
  role      String   // user, assistant
  content   String
  type      String   @default("text") // text, analysis, suggestion
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  session ChatSession @relation(fields: [sessionId], references: [id])

  @@map("chat_messages")
}

model Alert {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  symbol      String
  condition   String    // ABOVE, BELOW, CROSS
  targetValue Decimal   @map("target_value") @db.Decimal(12, 2)
  isActive    Boolean   @default(true) @map("is_active")
  triggeredAt DateTime? @map("triggered_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("alerts")
}

model ScreenerPreset {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  filters   Json
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("screener_presets")
}

model ChartDrawing {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  symbol    String
  timeframe String
  drawings  Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, symbol, timeframe])
  @@map("chart_drawings")
}

model Watchlist {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  symbols   String[]
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("watchlists")
}

model RefreshToken {
  id         String   @id @default(uuid())
  tokenId    String   @unique @map("token_id")
  userId     String   @map("user_id")
  isRevoked  Boolean  @default(false) @map("is_revoked")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
}

/// OHLCV time-series — enable TimescaleDB hypertable via migration:
/// SELECT create_hypertable('ohlcv', 'time', if_not_exists => TRUE);
model Ohlcv {
  time     DateTime @db.Timestamptz
  symbol   String
  open     Decimal  @db.Decimal(12, 2)
  high     Decimal  @db.Decimal(12, 2)
  low      Decimal  @db.Decimal(12, 2)
  close    Decimal  @db.Decimal(12, 2)
  volume   BigInt

  @@id([time, symbol])
  @@index([symbol, time(sort: Desc)])
  @@map("ohlcv")
}
