generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  displayName  String?  @map("display_name")
  cashBalance  Decimal  @default(1000000000) @map("cash_balance") @db.Decimal(18, 2)
  winRate      Float?   @default(0) @map("win_rate")
  createdAt    DateTime @default(now()) @map("created_at")

  positions     Position[]
  orders        Order[]
  chatSessions  ChatSession[]
  alerts        Alert[]
  presets       ScreenerPreset[]
  chartDrawings ChartDrawing[]
  watchlists    Watchlist[]
  posts         Post[]
  comments      Comment[]
  reactions     Reaction[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model Stock {
  symbol    String   @id
  name      String
  exchange  String   // HOSE, HNX, UPCOM
  industry  String?
  marketCap BigInt?  @map("market_cap")
  ceiling   Decimal? @db.Decimal(12, 2)
  floor     Decimal? @db.Decimal(12, 2)
  refPrice  Decimal? @map("ref_price") @db.Decimal(12, 2)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  positions Position[]
  orders    Order[]

  @@map("stocks")
}

model Position {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  symbol    String
  quantity  Int
  avgPrice  Decimal  @map("avg_price") @db.Decimal(12, 2)
  openedAt  DateTime @default(now()) @map("opened_at")

  user  User  @relation(fields: [userId], references: [id])
  stock Stock @relation(fields: [symbol], references: [symbol])

  @@map("positions")
}

model Order {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  symbol    String
  side      String   // BUY, SELL
  orderType String   @map("order_type") // LO, ATO, ATC, MP
  price     Decimal? @db.Decimal(12, 2)
  quantity  Int
  status    String   @default("PENDING") // PENDING, FILLED, CANCELLED
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id])
  stock Stock @relation(fields: [symbol], references: [symbol])

  @@map("orders")
}

model ChatSession {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String?
  createdAt DateTime @default(now()) @map("created_at")

  user     User          @relation(fields: [userId], references: [id])
  messages ChatMessage[]

  @@map("chat_sessions")
}

model ChatMessage {
  id        String   @id @default(uuid())
  sessionId String   @map("session_id")
  role      String   // user, assistant
  content   String
  type      String   @default("text") // text, analysis, suggestion
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  session ChatSession @relation(fields: [sessionId], references: [id])

  @@map("chat_messages")
}

model Alert {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  symbol      String
  condition   String    // ABOVE, BELOW, CROSS
  targetValue Decimal   @map("target_value") @db.Decimal(12, 2)
  isActive    Boolean   @default(true) @map("is_active")
  triggeredAt DateTime? @map("triggered_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("alerts")
}

model ScreenerPreset {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  filters   Json
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("screener_presets")
}

model ChartDrawing {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  symbol    String
  timeframe String
  drawings  Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, symbol, timeframe])
  @@map("chart_drawings")
}

model Watchlist {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  symbols   String[]
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("watchlists")
}

model RefreshToken {
  id         String   @id @default(uuid())
  tokenId    String   @unique @map("token_id")
  userId     String   @map("user_id")
  isRevoked  Boolean  @default(false) @map("is_revoked")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
}

/// OHLCV time-series — enable TimescaleDB hypertable via migration:
/// SELECT create_hypertable('ohlcv', 'time', if_not_exists => TRUE);
model Ohlcv {
  time     DateTime @db.Timestamptz
  symbol   String
  open     Decimal  @db.Decimal(12, 2)
  high     Decimal  @db.Decimal(12, 2)
  low      Decimal  @db.Decimal(12, 2)
  close    Decimal  @db.Decimal(12, 2)
  volume   BigInt

  @@id([time, symbol])
  @@index([symbol, time(sort: Desc)])
  @@map("ohlcv")
}

model Post {
  id             String    @id @default(uuid())
  authorId       String    @map("author_id")
  content        String
  taggedSymbols  String[]  @map("tagged_symbols")
  likesCount     Int       @default(0) @map("likes_count")
  commentsCount  Int       @default(0) @map("comments_count")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  author         User      @relation(fields: [authorId], references: [id])
  comments       Comment[]
  reactions      Reaction[]

  @@map("posts")
}

model Comment {
  id               String    @id @default(uuid())
  postId           String    @map("post_id")
  parentCommentId  String?   @map("parent_comment_id")
  authorId         String    @map("author_id")
  content          String
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  post             Post      @relation(fields: [postId], references: [id])
  author           User      @relation(fields: [authorId], references: [id])
  parentComment    Comment?  @relation("CommentToComment", fields: [parentCommentId], references: [id])
  replies          Comment[] @relation("CommentToComment")
  reactions        Reaction[]

  @@map("comments")
}

model Reaction {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  targetId   String   @map("target_id")
  targetType String   @map("target_type") // POST or COMMENT
  type       String   @default("LIKE")
  createdAt  DateTime @default(now()) @map("created_at")

  user       User     @relation(fields: [userId], references: [id])
  post       Post?    @relation(fields: [targetId], references: [id], map: "reaction_post_fkey")
  comment    Comment? @relation(fields: [targetId], references: [id], map: "reaction_comment_fkey")

  @@unique([userId, targetId, targetType])
  @@map("reactions")
}

model News {
  id              String   @id @default(uuid())
  newsId          String   @unique @map("news_id") // From vnstock
  symbol          String
  title           String
  url             String
  content         String?
  publishDate     DateTime @map("publish_date")
  friendlyKeyword String?  @map("friendly_keyword")
  sentimentLabel  String?  @map("sentiment_label") // POSITIVE, NEGATIVE, NEUTRAL
  sentimentScore  Float?   @map("sentiment_score") // -1 to 1
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([symbol, publishDate(sort: Desc)])
  @@map("news")
}

/// Tracks which trading days have been backfilled.
/// Idempotency check: on server startup, skip backfill if today's session is already logged.
model MarketSessionLog {
  id          String   @id @default(uuid())
  sessionDate DateTime @map("session_date") // Date only (no time)
  status      String   @default("PENDING")  // PENDING, BACKFILLING, COMPLETED, FAILED
  stockCount  Int      @default(0) @map("stock_count")
  ohlcvCount  Int      @default(0) @map("ohlcv_count")
  error       String?
  startedAt   DateTime @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")

  @@unique([sessionDate])
  @@map("market_session_logs")
}
