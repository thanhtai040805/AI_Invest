# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/aiinvest

# Redis (with auth in production)
REDIS_URL=redis://localhost:6379
# Production: REDIS_URL=redis://:your_redis_password@localhost:6379

# AI Engine
AI_ENGINE_URL=http://localhost:8000
AI_ENGINE_ADMIN_TOKEN=generate-a-strong-random-string-here
INTERNAL_SERVICE_TOKEN=generate-another-strong-random-string-here

# JWT (REQUIRED in production — no fallback)
JWT_ACCESS_SECRET=generate-a-strong-random-string-here
JWT_REFRESH_SECRET=generate-a-different-strong-random-string-here
JWT_EXPIRES_IN=24h

# Server
PORT=3001
NODE_ENV=development

# CORS (comma-separated domains in production)
CORS_ORIGIN=http://localhost:3000
# Production: CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email OTP Delivery (Option A: Gmail App Password via SMTP, OR Option B: Resend API)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-google-app-password
# RESEND_API_KEY=re_xxxxxxxxx
# EMAIL_FROM=AIInvest <no-reply@aiinvest.cloud>

# DNSE Integration (keep false on Local to avoid occupying PROD WebSocket slots)
DNSE_ENABLED=false
DNSE_REDIS_CHANNEL_PREFIX=dnse:event
