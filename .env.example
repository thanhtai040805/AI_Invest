# PostgreSQL
DB_PASSWORD=
DATABASE_URL=

# Redis (cache + DNSE event bus)
REDIS_URL=redis://localhost:6379

# Backend
PORT=3001
NODE_ENV=development
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=24h
CORS_ORIGIN=http://localhost:3000

# ── DNSE Lightspeed Open API ─────────────────────────────
# Register at https://entradex.dnse.com.vn → Lightspeed API
# After eKYC approval you receive: Client ID (API Key), Secret Key, Account No.
DNSE_ENABLED=true
DNSE_API_KEY=
DNSE_API_SECRET=
DNSE_ACCOUNT_NO=
DNSE_BASE_URL=https://openapi.dnse.com.vn
DNSE_REDIS_CHANNEL_PREFIX=dnse:event
DNSE_DEFAULT_SYMBOLS=VNM,FPT,VIC,SSI,HPG,VCB,MWG,MSN,TCB,ACB

# AI Engine
AI_ENGINE_URL=http://localhost:8000
LLM_API_KEY=
LLM_PROVIDER=openai

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:3001
