# =================================================================
# AIInvest Monorepo — Environment Variables Template
# =================================================================

# ── Core PostgreSQL 16 (TimescaleDB) ───────────────────────────
DB_PASSWORD=aiinvest_db_secret_change_me
DATABASE_URL=postgresql://postgres:aiinvest_db_secret_change_me@postgres:5432/aiinvest

# ── SAG PostgreSQL 16 + Qdrant (Research Profile — Isolated from Thesis 'sag') ──
SAG_DB_NAME=aiinvest_sag
SAG_DB_USER=aiinvest_sag
SAG_DB_PASSWORD=aiinvest_sag_local_only
SAG_DATABASE_URL=postgresql+asyncpg://aiinvest_sag:aiinvest_sag_local_only@sag-postgres:5432/aiinvest_sag
SAG_SAG_QDRANT_URL=http://sag-qdrant:6333
SAG_SAG_QDRANT_API_KEY=
SAG_QDRANT_API_KEY=

# ── Redis 7 (Cache & Market Data Pub/Sub) ─────────────────────
REDIS_PASSWORD=aiinvest_redis_secret_change_me
REDIS_URL=redis://:aiinvest_redis_secret_change_me@redis:6379

# ── RabbitMQ 3 (Event Bus) ────────────────────────────────────
RABBITMQ_USER=aiinvest_rabbit
RABBITMQ_PASS=aiinvest_rabbit_secret_change_me
RABBITMQ_URL=amqp://aiinvest_rabbit:aiinvest_rabbit_secret_change_me@rabbitmq:5672/

# ── Backend (Express + Prisma) ────────────────────────────────
PORT=3001
NODE_ENV=development
JWT_SECRET=change-me-to-a-strong-secret-in-production
JWT_ACCESS_SECRET=change-me-to-a-strong-access-secret-32bytes
JWT_REFRESH_SECRET=change-me-to-a-strong-refresh-secret-32bytes
JWT_EXPIRES_IN=24h
CORS_ORIGIN=http://localhost:3000

# ── SAG Knowledge Routing RAG Engine (FastAPI v1) ─────────────
SAG_ENVIRONMENT=dev
SAG_DEBUG=false
SAG_AUTH_MODE=continuum
SAG_BFF_SERVICE_TOKEN=aiinvest-sag-bff-dev-token-change-me-32bytes
SAG_SECRET_KEY=dev-insecure-secret-change-me-in-production-0123456789
SAG_TIMEZONE=Asia/Ho_Chi_Minh
SAG_PG_PORT=55432
SAG_QDRANT_PORT=16333
SAG_SAG_QDRANT_SHARED_COLLECTION=aiinvest_search_units
SAG_SAG_QDRANT_ON_DISK=true
SAG_SAG_QDRANT_SCALAR_QUANTIZATION=true
SAG_SAG_LANGUAGE=vi
SAG_LLM_PROVIDER=openai
SAG_LLM_BASE_URL=https://api.deepinfra.com/v1/openai
SAG_LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
SAG_LLM_API_KEY=
SAG_EMBEDDING_BASE_URL=https://api.deepinfra.com/v1/openai
SAG_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
SAG_EMBEDDING_API_KEY=
SAG_EMBEDDING_DIMENSIONS=1024
SAG_DECISION_PROVIDER=disabled
SAG_DECISION_MODEL=Kev-4b
SAG_SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1
SAG_SILICONFLOW_API_KEY=
# DeepInfra Reranker automatically reuses SAG_LLM_API_KEY / DEEPINFRA_API_KEY (safe no-op if key is empty)
SAG_RERANK_PROVIDER=deepinfra
SAG_RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
SAG_RERANK_BASE_URL=
SAG_RERANK_API_KEY=
SAG_USER_MEMORY_MODE=on
SAG_USER_MEMORY_QDRANT_COLLECTION=aiinvest_user_memories
SAG_USER_MEMORY_EXTRACTOR_MODEL=
SAG_USER_MEMORY_WORKER_ENABLED=true
SAG_USER_MEMORY_DEBOUNCE_SECONDS=8.0
# Read-only Core PostgreSQL DSN for catalog/screener & tier batch ingest (leave empty in Docker to auto-use Core postgres)
SAG_CORE_DATABASE_URL=
SAG_R2_MD_LOCAL_CACHE_DIR=/data/r2-md-cache
SAG_DOCUMENT_EVENT_EXTRACTION_ENABLED=false
SAG_KNOWLEDGE_WORKER_ENABLED=true
SAG_KNOWLEDGE_TREE_REBUILD_ENABLED=false
SAG_MINERU_OFFICIAL_MODEL=vlm
SAG_MINERU_POLL_TIMEOUT=900
# Supports single token OR Round-Robin multi-token pool (_0, _1, ...):
SAG_MINERU_OFFICIAL_API_TOKEN=
SAG_MINERU_OFFICIAL_API_TOKEN_0=
SAG_MINERU_OFFICIAL_API_TOKEN_1=

# ── AI Engine (FastAPI Quant Org) ─────────────────────────────
AI_ENGINE_URL=http://ai-engine:8000
AI_ENGINE_ADMIN_TOKEN=ai-engine-admin-token-32bytes
INTERNAL_SERVICE_TOKEN=internal-service-token-32bytes
# Optional legacy credentials; EvoMap is also used by OCR/triage.
XKIRO_API_KEY=
EVOMAP_API_KEY=
# Multi-agent LLM — DeepSeek V4.1 Flash via DeepInfra
MULTI_AGENT_LLM_PROVIDER=deepinfra
DEEPINFRA_API_KEY=
LLM_BASE_URL=https://api.deepinfra.com/v1/openai
MULTI_AGENT_ACCOUNT_ID=
MULTI_AGENT_MODE=SHADOW_RUNNER

# ── DNSE Lightspeed Open API ──────────────────────────────────
DNSE_ENABLED=false
DNSE_API_KEY=
DNSE_API_SECRET=
DNSE_ACCOUNT_NO=
DNSE_BASE_URL=https://openapi.dnse.com.vn
DNSE_REDIS_CHANNEL_PREFIX=dnse:event

# ── Cloudflare R2 Data Lake (BCTC Storage) ────────────────────
R2_ACCOUNT_ID=
R2_ENDPOINT_URL=
R2_BUCKET_NAME=aiinvest-bctc-prod
R2_TEST_BUCKET_NAME=aiinvest-bctc-test
R2_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ── Frontend (Next.js 16) ─────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=http://localhost:3001
