# =================================================================
# AIInvest Monorepo — Environment Variables Template
# =================================================================

# ── Core PostgreSQL 16 (TimescaleDB) ───────────────────────────
DB_PASSWORD=aiinvest_db_secret_change_me
DATABASE_URL=postgresql://postgres:aiinvest_db_secret_change_me@postgres:5432/aiinvest

# ── SAG PostgreSQL 16 (pgvector) ──────────────────────────────
SAG_DB_PASSWORD=sag_db_secret_change_me
SAG_DATABASE_URL=postgresql+asyncpg://sag:sag_db_secret_change_me@sag-postgres:5432/sag

# ── Redis 7 (Cache & Market Data Pub/Sub) ─────────────────────
REDIS_PASSWORD=aiinvest_redis_secret_change_me
REDIS_URL=redis://:aiinvest_redis_secret_change_me@redis:6379

# ── RabbitMQ 3 (Event Bus) ────────────────────────────────────
RABBITMQ_USER=aiinvest_rabbit
RABBITMQ_PASS=aiinvest_rabbit_secret_change_me
RABBITMQ_URL=amqp://aiinvest_rabbit:aiinvest_rabbit_secret_change_me@rabbitmq:5672/

# ── Backend (Express + Prisma) ────────────────────────────────
PORT=3001
NODE_ENV=development
JWT_SECRET=change-me-to-a-strong-secret-in-production
JWT_ACCESS_SECRET=change-me-to-a-strong-access-secret-32bytes
JWT_REFRESH_SECRET=change-me-to-a-strong-refresh-secret-32bytes
JWT_EXPIRES_IN=24h
CORS_ORIGIN=http://localhost:3000

# ── SAG Forensic Engine (FastAPI v2) ──────────────────────────
SAG_ENVIRONMENT=dev
SAG_DEBUG=false
SAG_SECRET_KEY=dev-insecure-secret-change-me-in-production-0123456789
SAG_SERVICE_TOKEN=sag-internal-service-token-32bytes
SAG_ADMIN_TOKEN=sag-internal-admin-token-32bytes
SAG_LLM_MODEL=openai/gpt-4.1-mini
SAG_LLM_API_KEY=
SAG_EMBEDDING_API_KEY=

# ── AI Engine (FastAPI Quant Org) ─────────────────────────────
AI_ENGINE_URL=http://ai-engine:8000
AI_ENGINE_ADMIN_TOKEN=ai-engine-admin-token-32bytes
INTERNAL_SERVICE_TOKEN=internal-service-token-32bytes
EVOMAP_API_KEY=
GROQ_API_KEY0=
GROQ_API_KEY1=
GROQ_MODEL0=openai/gpt-oss-120b
MULTI_AGENT_ACCOUNT_ID=
MULTI_AGENT_MODE=SHADOW_RUNNER
STANDALONE_ML_ACCOUNT_ID=standalone-pure-ml-fund-account
STANDALONE_ML_MODE=SHADOW_RUNNER
STANDALONE_ML_POSITION_WEIGHT=0.20

# ── DNSE Lightspeed Open API ──────────────────────────────────
DNSE_ENABLED=false
DNSE_API_KEY=
DNSE_API_SECRET=
DNSE_ACCOUNT_NO=
DNSE_BASE_URL=https://openapi.dnse.com.vn
DNSE_REDIS_CHANNEL_PREFIX=dnse:event

# ── Cloudflare R2 Data Lake (BCTC Storage) ────────────────────
R2_ACCOUNT_ID=
R2_ENDPOINT_URL=
R2_BUCKET_NAME=aiinvest-bctc-prod
R2_TEST_BUCKET_NAME=aiinvest-bctc-test
R2_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ── Frontend (Next.js 16) ─────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=http://localhost:3001
